{
  "info": {
    "_postman_id": "c1f7a42b-5813-49dc-8c46-9d2243453b30",
    "name": "API de Tarefas - Express & NeonDB",
    "description": "Coleção de testes para a API RESTful de Tarefas desenvolvida com Express, Sequelize, NeonDB e Zod.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Healthcheck / Raiz",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        },
        "description": "Verifica se a API está online e retorna a lista de rotas."
      },
      "response": []
    },
    {
      "name": "Criar Tarefa (Sucesso)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code deve ser 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Deve retornar o objectId gerado\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('objectId');",
              "    pm.collectionVariables.set(\"objectId\", jsonData.objectId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"Estudar para prova de Web e configurar NeonDB\",\n  \"concluida\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tarefas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas"
          ]
        },
        "description": "Cria uma nova tarefa e armazena automaticamente o objectId retornado para os próximos testes."
      },
      "response": []
    },
    {
      "name": "Criar Tarefa (Validação de Erro - Sem Descrição)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code deve ser 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"concluida\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tarefas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas"
          ]
        },
        "description": "Deve falhar com status 400 Bad Request pois o campo descricao é obrigatório."
      },
      "response": []
    },
    {
      "name": "Listar Tarefas",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Resposta deve ser um array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tarefas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas"
          ]
        },
        "description": "Retorna uma lista de todas as tarefas cadastradas."
      },
      "response": []
    },
    {
      "name": "Buscar Tarefa por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Deve retornar o mesmo objectId consultado\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.objectId).to.eql(pm.collectionVariables.get(\"objectId\"));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tarefas/{{objectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas",
            "{{objectId}}"
          ]
        },
        "description": "Busca os detalhes de uma tarefa pelo UUID objectId."
      },
      "response": []
    },
    {
      "name": "Buscar Tarefa por ID (404 Not Found)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code deve ser 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tarefas/00000000-0000-0000-0000-000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas",
            "00000000-0000-0000-0000-000000000000"
          ]
        },
        "description": "Consulta um UUID inexistente e valida o retorno 404."
      },
      "response": []
    },
    {
      "name": "Atualizar Tarefa",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Status concluida deve ter mudado para true\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.concluida).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"Estudar para prova de Web e configurar NeonDB - Concluído!\",\n  \"concluida\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tarefas/{{objectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas",
            "{{objectId}}"
          ]
        },
        "description": "Atualiza a descrição e/ou o status de uma tarefa existente."
      },
      "response": []
    },
    {
      "name": "Remover Tarefa",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tarefas/{{objectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas",
            "{{objectId}}"
          ]
        },
        "description": "Remove uma tarefa existente utilizando seu objectId."
      },
      "response": []
    },
    {
      "name": "Remover Tarefa Inexistente (404 Not Found)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code deve ser 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tarefas/00000000-0000-0000-0000-000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas",
            "00000000-0000-0000-0000-000000000000"
          ]
        },
        "description": "Tenta remover uma tarefa inexistente e valida o retorno 404."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "objectId",
      "value": "",
      "type": "string"
    }
  ]
}
